{
  "name": "rolldown-plugin-module-replace",
  "version": "0.1.1",
  "description": "Replace aliases for bundle dependencies",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "lint": "eslint --fix './**/*.{js,mjs,ts}'",
    "lint:ci": "eslint --max-warnings 0 './**/*.{js,mjs,ts}'",
    "test": "vitest",
    "prepack": "tsdown",
    "release": "release-it"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CyanSalt/rolldown-plugin-module-replace.git"
  },
  "bugs": {
    "url": "https://github.com/CyanSalt/rolldown-plugin-module-replace/issues"
  },
  "homepage": "https://github.com/CyanSalt/rolldown-plugin-module-replace#readme",
  "keywords": [
    "rolldown",
    "rolldown-plugin",
    "alias"
  ],
  "author": "CyanSalt",
  "license": "ISC",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.15.0",
      "onFail": "error"
    },
    "packageManager": [
      {
        "name": "pnpm",
        "version": "^11.0.0",
        "onFail": "error"
      },
      {
        "name": "npm",
        "onFail": "ignore"
      }
    ]
  },
  "devDependencies": {
    "@cyansalt/eslint-config": "^4.6.0",
    "@cyansalt/tsconfig": "^3.0.2",
    "@release-it/conventional-changelog": "^11.0.0",
    "@types/node": "^25.6.2",
    "eslint": "^10.3.0",
    "release-it": "^20.0.1",
    "rolldown": "1.0.0",
    "tsdown": "^0.22.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "magic-string": "^0.30.21",
    "oxc-parser": "^0.129.0",
    "oxc-walker": "^1.0.0"
  }
}
